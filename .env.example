# Copy to .env (never commit it). Choose independently generated long random values.
# Use URL-safe alphanumeric PostgreSQL password: it is interpolated into DATABASE_URL.
POSTGRES_DB=pollinoz
POSTGRES_USER=pollinoz
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# JWT_SECRET is an obsolete demo-only fallback; do not use it on a VPS.
EDDS_MIS_API_KEY=
# The default Compose deployment has no public demo users; seed data remain synthetic.
DEMO_MODE=false
OFFLINE=false
# Disable the quick demo accounts even when DEMO_MODE=true.
DEMO_ACCOUNTS_ENABLED=true
# Bind HTTP to loopback until TLS reverse proxy is configured.
WEB_PORT=80
# Model defaults and endpoints; changing them does not validate the model.
FORECAST_URL=https://api.open-meteo.com/v1/forecast
ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CLINICAL_THRESHOLD=10
BUDGET_RUB=198000000
IMPLEMENTATION_COST_RUB=900000
WORKERS=185
# Explicitly opt in only after validation and recipient consent.
TELEGRAM_BOT_TOKEN=
ENABLE_LIVE_TELEGRAM=false
# Comma-separated external origins, normally empty for same-origin nginx.
CORS_ALLOWED_ORIGINS=
# DATABASE_URL is assembled by Compose from PostgreSQL variables. For non-Compose
# installations set DATABASE_URL=postgresql+psycopg://user:password@host:5432/db
# MODEL_PATH and UPLOAD_DIR are configured to /app/data in Compose.
